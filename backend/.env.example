# ==========================================
# YANF Backend Environment Variables Template
# ==========================================

# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/yanf?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Client / Frontend URL(s) for CORS (comma-separated if multiple)
# Local: http://localhost:5173,http://localhost:3000
# Production: https://yanfglobal.com,https://www.yanfglobal.com
CLIENT_URL=http://localhost:5173,http://localhost:3000,https://yanfglobal.com
FRONTEND_URL=http://localhost:5173

# Default Superadmin Account Initial Seed (seeded automatically on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_EMAIL=admin@yanfglobal.com

# SMTP Email Configuration (for OTP delivery & login verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="YANF Auth <noreply@yanfglobal.com>"

# Google Drive API Configuration (for Media Vault cloud uploads)
GDRIVE_CLIENT_ID=your_gdrive_client_id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your_gdrive_client_secret
GDRIVE_REFRESH_TOKEN=your_gdrive_refresh_token
GDRIVE_FOLDER_ID=your_gdrive_folder_id
