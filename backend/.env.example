# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/yanf_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=yanf_super_secret_jwt_key_2026

# Admin Initial Credentials (Seeded into MongoDB on server boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=yanf2026
ADMIN_EMAIL=aditya@yanfglobal.com

# SMTP Email Configuration (Nodemailer for Email OTPs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aditya@yanfglobal.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="YANF Auth <aditya@yanfglobal.com>"

# Google Drive API Configuration (OAuth2 Credentials)
GDRIVE_CLIENT_ID=your_oauth_client_id
GDRIVE_CLIENT_SECRET=your_oauth_client_secret
GDRIVE_REFRESH_TOKEN=your_oauth_refresh_token
GDRIVE_FOLDER_ID=your_google_drive_folder_id
